    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "oxlint": "^1.89.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
