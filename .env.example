# Copie para .env (que NUNCA vai para o Git) e preencha.
# Gere segredos com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# API
NODE_ENV=development
PORT=3333
LOG_LEVEL=info
LIMITE_REQUISICOES_POR_MINUTO=60
# Segredo do HMAC dos pseudônimos (ALUNO_xxxxxx). Mínimo de 32 caracteres. Trocar invalida os códigos antigos.
PSEUDONIMO_SEGREDO=

# Banco (docker compose)
POSTGRES_DB=threshold
POSTGRES_USER=threshold
POSTGRES_PASSWORD=
DATABASE_URL=postgres://threshold:${POSTGRES_PASSWORD}@localhost:5432/threshold

# ---------------------------------------------------------------------------
# IA da Lantern (opcional). Sem isto, tudo funciona e a Lantern aparece "offline".
# A chave fica SÓ no servidor: o navegador nunca a vê. Nunca faça commit do .env.
# Escolha UMA das opções abaixo e descomente as linhas dela.
# ---------------------------------------------------------------------------
# Mensagens por minuto por pessoa (controle de custo e abuso). Só respostas que deram certo contam.
# Para apresentação, 20 a 30 é confortável.
LIMITE_LANTERN_POR_MINUTO=20

# Opção A — Claude (Anthropic). Chave em https://platform.claude.com  (modelo mais barato e rápido: Haiku)
# LLM_PROVEDOR=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODELO=claude-haiku-5-5
# (Este modelo raciocina antes de responder e o raciocínio conta no teto de tokens: os tetos do código já têm folga.)

# Opção B — OpenAI ou qualquer API compatível (/chat/completions)
# LLM_PROVEDOR=openai
# LLM_API_KEY=sk-...
# LLM_MODELO=gpt-5.4-mini

# Opção C — Ollama na sua máquina (grátis, sem chave; mais lento). Antes: ollama pull llama3.2
# LLM_PROVEDOR=openai
# LLM_MODELO=llama3.2
# LLM_URL_BASE=http://host.docker.internal:11434/v1   # com docker compose
# LLM_URL_BASE=http://localhost:11434/v1              # com npm run dev
