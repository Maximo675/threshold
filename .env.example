# Copie para .env (que NUNCA vai para o Git) e preencha.
# Gere segredos com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# API
NODE_ENV=development
PORT=3333
LOG_LEVEL=info
LIMITE_REQUISICOES_POR_MINUTO=60
# Segredo do HMAC dos pseudÃ´nimos (ALUNO_xxxxxx). MÃ­nimo de 32 caracteres. Trocar invalida os cÃ³digos antigos.
PSEUDONIMO_SEGREDO=

# Banco (docker compose)
POSTGRES_DB=threshold
POSTGRES_USER=threshold
POSTGRES_PASSWORD=
DATABASE_URL=postgres://threshold:${POSTGRES_PASSWORD}@localhost:5432/threshold

